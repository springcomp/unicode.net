<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <!-- Package metadata -->
    <PackageId>Unicode.NET</PackageId>
    <Version>1.0.0</Version>
    <Authors>Springcomp</Authors>
    <Description>Unicode data and algorithms library for .NET. Provides code point sets, general categories, blocks, scripts, binary properties, case folding, XML character sets, and property resolution. Designed for XSD/XPath regex engines and Unicode-aware text processing.</Description>
    <PackageTags>unicode;ucd;character-database;case-folding;xml;xpath;xsd;regex</PackageTags>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/springcomp/uni</PackageProjectUrl>
    <RepositoryUrl>https://github.com/springcomp/uni</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- NuGet symbol package -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <!-- Deterministic build -->
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
